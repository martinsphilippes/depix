{
  "name": "depix-wallet",
  "version": "0.2.0",
  "private": true,
  "description": "Carteira DePix — Pix <-> DePix sobre Liquid Network, non-custodial",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace=@depix/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:concurrency": "node --test --experimental-strip-types \"packages/ledger/test/concurrency.pg.test.ts\"",
    "migrate": "node --experimental-strip-types packages/db/src/cli.ts migrate",
    "clean": "rm -rf packages/*/dist apps/*/dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
