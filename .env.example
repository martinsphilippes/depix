# Configuração da API. Copie para .env e ajuste.
#
# O gate de ambiente (apps/api/src/config.ts) recusa subir a aplicação em
# configuração perigosa. Isso é deliberado: falhar no boot é muito melhor
# do que descobrir o problema na primeira transação.

# development | testnet | staging | production
APP_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/depix

# Salt do hash de IP. Sem ele o hash é reversível por força bruta — o
# espaço de endereços IPv4 inteiro cabe numa tabela. Gere um valor
# aleatório e trate como segredo.
IP_HASH_SALT=troque-por-um-valor-aleatorio

PORT=3001
LOG_LEVEL=info

# --- Operador DePix ---------------------------------------------------------
# sandbox  → adapter em memória, sem dinheiro real (padrão)
# depixapp → operador real (https://depixapp.com/docs/en/)
DEPIX_PROVIDER=sandbox

# Chave do operador.
#   sk_test_… → sandbox, liberada sem aprovação
#   sk_live_… → produção, exige aprovação manual do operador
#
# A aplicação RECUSA subir com sk_live_ fora de APP_ENV=production, e
# recusa sk_test_ em produção.
# DEPIX_API_KEY=sk_test_...

# Segredo de verificação dos webhooks (HMAC-SHA256).
# DEPIX_WEBHOOK_SECRET=whsec_...

# DEPIX_BASE_URL=https://api.depixapp.com

# --- Liberação de fundos reais ---------------------------------------------
# Só tem efeito com APP_ENV=production, e a aplicação não sobe em produção
# sem isto. Antes de definir como "yes":
#   1. validação jurídica dos 10 pontos de REGULATORY_ARCHITECTURE.md §5
#   2. aprovação da chave sk_live_ pelo operador
#   3. revisão de segurança
#   4. suíte de testes financeiros passando
# ENABLE_REAL_FUNDS=no

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Testes -----------------------------------------------------------------
# Sem isto, a suíte usa PGlite (Postgres em WASM, in-process) e os testes de
# concorrência são PULADOS — PGlite tem sessão única e contenção de lock não
# acontece nele. Defina para rodar o teste de gasto duplo de verdade.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/depix_test
