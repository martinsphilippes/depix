# Configuração da API. Copie para .env e ajuste.
#
# O gate de ambiente (apps/api/src/config.ts) recusa subir a aplicação em
# configuração perigosa. Isso é deliberado: falhar no boot é muito melhor
# do que descobrir o problema na primeira transação.

# development | testnet | staging | production
APP_ENV=development

# --- Firebase / Firestore ---------------------------------------------------
FIREBASE_PROJECT_ID=demo-depix-dev

# Emulador. Com esta variável definida, NADA toca o projeto real.
#
# ⚠️ Fora de produção, a aplicação RECUSA subir sem emulador, a menos que
# ALLOW_REAL_FIRESTORE=yes seja definido explicitamente. O motivo: com
# Firestore, a diferença entre banco de brincadeira e banco de produção é uma
# variável de ambiente, e a suíte de testes apaga todos os documentos.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Descomente APENAS se for mesmo a intenção apontar para o projeto real
# fora de produção.
# ALLOW_REAL_FIRESTORE=yes

# Em produção, autenticação por service account. Nunca commitar o arquivo.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# Banco nomeado do Firestore, se não for o padrão.
# FIRESTORE_DATABASE_ID=

# --- Aplicação --------------------------------------------------------------
PORT=3001
LOG_LEVEL=info

# Salt do hash de IP. Sem ele o hash é reversível por força bruta — o espaço
# de endereços IPv4 inteiro cabe numa tabela. Gere um valor aleatório e trate
# como segredo.
IP_HASH_SALT=troque-por-um-valor-aleatorio

# Chave AES-256-GCM (32 bytes em base64) para cifrar em repouso o descriptor
# watch-only. Ele não permite gastar, mas contém a master blinding key: quem
# o tiver consegue VER saldos e transações. Em produção isto vem de KMS/vault,
# não de arquivo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- WebAuthn / passkey -----------------------------------------------------
# A passkey é o único fator de autenticação: não há senha para vazar nem
# e-mail para phishar. Isso desloca todo o peso para estas três variáveis.
#
# Na Vercel, estas duas são deduzidas de VERCEL_PROJECT_PRODUCTION_URL e não
# precisam ser definidas. Defina apenas fora da Vercel, ou com domínio próprio.
#
# RP ID: o domínio, SEM esquema e SEM porta. É o que amarra a credencial ao
# nosso site — o navegador se recusa a usar uma passkey de outro domínio, e é
# daí que vem a resistência a phishing. Errar aqui não dá erro visível: dá um
# sistema que aceita assinatura de qualquer lugar.
WEBAUTHN_RP_ID=localhost

# Nome exibido pelo autenticador na hora de cadastrar/confirmar.
WEBAUTHN_RP_NAME=Carteira

# Origem completa esperada no clientData. Aceita lista separada por vírgula
# (ex.: web e app em subdomínios distintos).
#
# ⚠️ A aplicação RECUSA subir em produção com http:// aqui. Sobre HTTP a
# proteção antiphishing não vale nada.
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Operador DePix ---------------------------------------------------------
# sandbox  → adapter em memória, sem dinheiro real (padrão)
# depixapp → operador real (https://depixapp.com/docs/en/)
DEPIX_PROVIDER=sandbox

# Chave do operador.
#   sk_test_… → sandbox, liberada sem aprovação
#   sk_live_… → produção, exige aprovação manual do operador
#
# A aplicação RECUSA subir com sk_live_ fora de APP_ENV=production, e recusa
# sk_test_ em produção.
# DEPIX_API_KEY=sk_test_...

# Segredo de verificação dos webhooks (HMAC-SHA256).
# DEPIX_WEBHOOK_SECRET=whsec_...

# DEPIX_BASE_URL=https://api.depixapp.com

# --- Liberação de fundos reais ---------------------------------------------
# Só tem efeito com APP_ENV=production, e a aplicação não sobe em produção
# sem isto. Antes de definir como "yes":
#   1. validação jurídica dos 10 pontos de REGULATORY_ARCHITECTURE.md §5
#   2. aprovação da chave sk_live_ pelo operador
#   3. verificação do contrato de depósito contra o sandbox
#   4. revisão de segurança e suíte financeira passando
# ENABLE_REAL_FUNDS=no

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# Rede Liquid usada pela carteira do dispositivo.
#
# Ausente ou qualquer valor != mainnet significa testnet — a mesma postura do
# gate do servidor: mover dinheiro de verdade exige intenção explícita, nunca
# acontece por padrão.
#
# Vale só para carteiras NOVAS. O cofre grava a própria rede, e uma carteira
# criada em testnet continua operando em testnet mesmo depois de a variável
# mudar — trocar de rede é criar ou restaurar carteira, não editar uma linha
# de configuração.
# NEXT_PUBLIC_LIQUID_NETWORK=testnet
