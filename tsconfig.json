{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@depix/core": [
        "./packages/core/src/index.ts"
      ],
      "@depix/ledger": [
        "./packages/ledger/src/index.ts"
      ],
      "@depix/providers": [
        "./packages/providers/src/index.ts"
      ],
      "@depix/app": [
        "./packages/app/src/index.ts"
      ],
      "@depix/firestore": [
        "./packages/firestore/src/index.ts"
      ],
      "@depix/wallet": [
        "./packages/wallet/src/index.ts"
      ],
      "@depix/core/browser": [
        "./packages/core/src/browser.ts"
      ],
      "@depix/wallet/vault": [
        "./packages/wallet/src/vault.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "apps/web"
  ]
}
